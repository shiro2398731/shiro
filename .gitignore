# ---- data --------------------------------------------------------------
# Archive, downloaded imagery, inbox/outbox, logs. This is the largest thing
# in the tree (roughly 250 MB) and none of it belongs in version control:
# it is state, not source, and it is regenerated by running the system.
data/

# ---- environment -------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- credentials -------------------------------------------------------
# Nothing that could carry a token or a key.
.env
.env.*
config.local.*
*_secret*
*token*.txt

# ---- editor / os -------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- large artifacts ---------------------------------------------------
*.zip
*.tar.gz
*.7z
*.h5
*.nc
*.tif
*.tiff
*.jp2
*.hgt

# her body bundles are state, not source
*.bundle
her.bundle
